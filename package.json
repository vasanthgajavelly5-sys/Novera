{
  "name": "novera",
  "productName": "Novera",
  "version": "3.0.0",
  "description": "A private, open-source Windows EPUB reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "validate:corpus": "node scripts/validate-corpus.js",
    "dist": "electron-builder --win nsis",
    "dist:win": "electron-builder --win nsis",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "epub",
    "reader",
    "books",
    "desktop",
    "windows"
  ],
  "author": "Vasanth Gajavelly",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasanthgajavelly5-sys/Novera.git"
  },
  "bugs": {
    "url": "https://github.com/vasanthgajavelly5-sys/Novera/issues"
  },
  "homepage": "https://github.com/vasanthgajavelly5-sys/Novera#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novera.reader",
    "productName": "Novera",
    "copyright": "Copyright © 2026 Vasanth Gajavelly",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "node_modules/epubjs/**/*",
      "node_modules/jszip/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB Electronic Publication",
          "description": "Electronic Publication Book File",
          "role": "Viewer",
          "icon": "assets/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Novera",
      "uninstallDisplayName": "Novera EPUB Reader",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico"
    }
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1"
  }
}
