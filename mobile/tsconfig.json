{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["./*"],
      "@/theme/*": ["theme/*"],
      "@/components/*": ["components/*"],
      "@/hooks/*": ["hooks/*"],
      "@/models/*": ["models/*"],
      "@/repositories/*": ["repositories/*"],
      "@/utils/*": ["utils/*"]
    },
    "types": ["react", "react-native", "jest", "@types/react", "@types/react-native"]
  },
  "include": [
    "app/**/*",
    "components/**/*",
    "hooks/**/*",
    "models/**/*",
    "repositories/**/*",
    "theme/**/*",
    "types/**/*",
    "utils/**/*",
    "App.tsx",
    "index.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}